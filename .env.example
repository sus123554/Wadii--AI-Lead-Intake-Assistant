# Wadii AI Lead Intake Assistant - Environment Configuration
# Copy this file to server/.env and provide your OpenAI API key.
# NOTE: Never commit your actual .env file or API key!

# Port for the Node/Express backend server
PORT=5000

# OpenAI API Key (Secret: Keep on backend only, never expose to frontend)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use (default: gpt-4o-mini for fast & cost-efficient extraction, or gpt-4o)
OPENAI_MODEL=gpt-4o-mini
